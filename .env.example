# Copy this file to .env and change what you need. Every line is optional.

# Port VCast listens on. If you change it, also set the address in the extension popup
# (shown when the popup cannot reach VCast).
VCAST_PORT=8787

# How much to log: debug, info, warn, error, off
VCAST_LOG_LEVEL=info

# Where the log file goes. Default: .vcast/vcast.log in your home folder.
# VCAST_LOG_FILE=C:\Users\me\vcast.log

# Where the permissions given by TVs are remembered. Default: .vcast/tvs.json in your home folder.
# VCAST_SAVED_TVS_FILE=C:\Users\me\vcast-tvs.json

# How long a pairing code on the TV stays valid, in seconds (30 to 3600).
VCAST_CODE_LIFE_SECONDS=300

# How many wrong codes are allowed per minute before pairing is paused (1 to 100).
VCAST_WRONG_CODES_PER_MINUTE=5
